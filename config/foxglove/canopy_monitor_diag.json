    "userNodes": {
        "mission-progress": {
            "name": "mission_progress",
            "sourceCode": "// Mission progress: M of N seedling sites visited, % complete, digging obstacles.\n//\n// Progress is read from nav_viz_node's /vis/seedlings, which it republishes at\n// 5 Hz: one sphere per seedling in the complete plan, grey once plan_manager\n// has removed that seedling from /planning/remaining_plan (orange = current\n// target, green = still to go).\n//\n// This script deliberately keeps NO progress state of its own. Foxglove\n// restarts user scripts, wiping their variables, whenever the bridge's topic\n// list changes - e.g. each time obstacle_pipeline_manager stops and restarts\n// the lidar nodes around planting. Reading the counts fresh from every\n// /vis/seedlings message makes the summary correct again within 0.2 s of a\n// restart, a Wi-Fi reconnect or a late join.\n//\n// The digging-obstacle skip count is the one exception: nothing on the robot\n// keeps it, so it is counted here and is BEST-EFFORT. A script restart resets\n// it to 0, and a site skipped before that restart is then shown as planted.\n\nconst SEEDLINGS_TOPIC = \"/vis/seedlings\";\nconst SPHERE = 2; // visualization_msgs/Marker.SPHERE\n\n// nav_viz_node GREY = (0.6, 0.6, 0.6): seedling no longer in remaining_plan.\nfunction isVisited(c: { r: number; g: number; b: number }): boolean {\n  return Math.abs(c.r - 0.6) < 0.05 && Math.abs(c.g - 0.6) < 0.05 && Math.abs(c.b - 0.6) < 0.05;\n}\n\nexport const inputs = [SEEDLINGS_TOPIC, \"/planting_state\"];\nexport const output = \"/studio_script/mission_progress\";\n\n// CLEAR    - no obstacle at the current / last site\n// ACTIVE   - planting_fsm is in DIGGING_OBSTACLE: drill aborted, auger retracting,\n//            behavior_fsm holds navigation until planting_fsm reaches IDLE\n// SKIPPED  - auger is home after an obstacle; that site was skipped. Stays\n//            until the next planting sequence starts.\ntype ObstacleState = \"CLEAR\" | \"ACTIVE\" | \"SKIPPED\";\n\ntype Output = {\n  planted: number;\n  total: number; // -1 until /vis/seedlings has been received\n  remaining: number;\n  visited: number; // planted + skipped\n  percent_complete: number;\n  digging_obstacle: boolean;\n  obstacle_state: ObstacleState;\n  obstacles_skipped: number; // best-effort, see top of file\n  minutes_since_obstacle: number;\n  summary: string;\n};\n\ntype Ev = { topic: string; receiveTime: { sec: number; nsec: number }; message: any };\n\n// Snapshot of the latest /vis/seedlings message (refreshed 5x per second), kept\n// only so a /planting_state event can also publish an up-to-date summary.\nlet total = -1;\nlet visited = 0;\n\n// Best-effort: lost when Foxglove restarts the script (see top of file).\nlet obstacleState: ObstacleState = \"CLEAR\";\nlet obstaclesSkipped = 0;\nlet lastObstacleT = -1;\n\nfunction onSeedlings(msg: any): void {\n  const spheres = (msg?.markers ?? []).filter(\n    (m: any) => m.ns === \"seedlings\" && m.type === SPHERE,\n  );\n  total = spheres.length;\n  visited = spheres.filter((m: any) => isVisited(m.color)).length;\n}\n\nfunction onPlantingState(state: string, t: number): void {\n  if (state === \"DIGGING_OBSTACLE\") {\n    if (obstacleState !== \"ACTIVE\") obstaclesSkipped += 1;\n    obstacleState = \"ACTIVE\";\n    lastObstacleT = t;\n  } else if (state === \"IDLE\") {\n    // DIGGING_OBSTACLE -> IDLE is the abort finishing: auger home, site skipped.\n    if (obstacleState === \"ACTIVE\") obstacleState = \"SKIPPED\";\n  } else {\n    // Any other state (a new sequence starting, COMPLETE, FAULT) clears it.\n    obstacleState = \"CLEAR\";\n  }\n}\n\nexport default function script(event: Ev): Output {\n  const t = event.receiveTime.sec + event.receiveTime.nsec * 1e-9;\n  if (event.topic === SEEDLINGS_TOPIC) onSeedlings(event.message);\n  else if (event.topic === \"/planting_state\") onPlantingState(String(event.message?.data ?? \"\").trim(), t);\n\n  // Always publish (no early return), so the obstacle indicators work\n  // before/without a plan.\n  const hasPlan = total > 0;\n  const remaining = hasPlan ? total - visited : 0;\n  // A skip can only be counted against a visited site.\n  const skipped = Math.min(obstaclesSkipped, visited);\n  const planted = Math.max(0, visited - skipped);\n\n  let summary = !hasPlan\n    ? \"Waiting for plan…\"\n    : remaining === 0\n      ? `Mission complete: visited all ${total} seedling sites.`\n      : `Visited ${visited} out of ${total} seedling sites.`;\n  if (obstacleState === \"ACTIVE\")\n    summary += \" ⚠ Digging obstacle — auger retracting, skipping this seedling.\";\n  if (skipped > 0)\n    summary += ` ${skipped} site${skipped === 1 ? \"\" : \"s\"} skipped (digging obstacle).`;\n\n  return {\n    planted,\n    total,\n    remaining,\n    visited,\n    // Sites done (planted or skipped), so a finished mission reads 100%.\n    percent_complete: hasPlan ? (100 * visited) / total : 0,\n    digging_obstacle: obstacleState === \"ACTIVE\",\n    obstacle_state: obstacleState,\n    obstacles_skipped: skipped,\n    minutes_since_obstacle: lastObstacleT >= 0 ? (t - lastObstacleT) / 60 : -1,\n    summary,\n  };\n}\n"
        },
        "terrain-slope": {
            "name": "terrain_slope",
            "sourceCode": "// Terrain slope from IMU gravity vector (works without an orientation estimate).\n// Low-pass filtered; valid while the robot isn't accelerating hard.\nconst IMU_TOPIC = \"/w200_0120/sensors/imu_0/data\";\nconst ALPHA = 0.1;             // smoothing (0..1, lower = smoother)\n\nexport const inputs = [IMU_TOPIC];\nexport const output = \"/studio_script/terrain_slope\";\n\ntype Output = { pitch_deg: number; roll_deg: number; slope_deg: number };\ntype Ev = { topic: string; receiveTime: { sec: number; nsec: number }; message: any };\n\nlet ax = 0, ay = 0, az = 9.81, init = false;\nconst deg = (r: number) => (r * 180) / Math.PI;\n\nexport default function script(event: Ev): Output {\n  const a = event.message.linear_acceleration;\n  if (!init) { ax = a.x; ay = a.y; az = a.z; init = true; }\n  ax += ALPHA * (a.x - ax); ay += ALPHA * (a.y - ay); az += ALPHA * (a.z - az);\n  const pitch = Math.atan2(-ax, Math.sqrt(ay * ay + az * az));\n  const roll = Math.atan2(ay, az);\n  const slope = Math.acos(Math.min(1, Math.abs(az) / Math.sqrt(ax*ax + ay*ay + az*az)));\n  return { pitch_deg: deg(pitch), roll_deg: deg(roll), slope_deg: deg(slope) };\n}\n"
        }
    },
    "playbackConfig": {
        "speed": 1
    },
    "layout": "Tab!root"
}