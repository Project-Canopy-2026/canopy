    "userNodes": {
        "mission-progress": {
            "name": "mission_progress",
            "sourceCode": "// Mission progress: M of N planted, % complete, planting rate, digging obstacles.\n// Inputs come from plan_manager and planting_fsm. PlantingPlan's array field is\n// found automatically (first array in the message) - set PLAN_FIELD if yours differs.\nconst PLAN_FIELD: string | undefined = \"seedlings\";\nconst RATE_WINDOW_S = 1800; // rolling window for planting rate (30 min)\n\nexport const inputs = [\n  \"/planning/complete_plan\",\n  \"/planning/remaining_plan\",\n  \"/behavior/on_seedling_reached\",\n  \"/planting_state\",\n];\nexport const output = \"/studio_script/mission_progress\";\n\n// CLEAR    - no obstacle at the current / last site\n// ACTIVE   - planting_fsm is in DIGGING_OBSTACLE: drill aborted, auger retracting,\n//            behavior_fsm holds navigation until planting_fsm reaches IDLE\n// SKIPPED  - auger is home after an obstacle; that site was skipped. Stays\n//            until the next planting sequence starts.\ntype ObstacleState = \"CLEAR\" | \"ACTIVE\" | \"SKIPPED\";\n\ntype Output = {\n  planted: number;\n  total: number;\n  remaining: number;\n  percent_complete: number;\n  rate_per_hour: number;\n  minutes_since_last: number;\n  eta_minutes: number;\n  digging_obstacle: boolean;\n  obstacle_state: ObstacleState;\n  obstacles_skipped: number;\n  minutes_since_obstacle: number;\n  summary: string;\n};\n\ntype Ev = { topic: string; receiveTime: { sec: number; nsec: number }; message: any };\n\nlet total = -1;\nlet remaining = -1;\n// complete_plan is a one-shot that bags often miss; fall back to the largest\n// remaining_plan seen (plan_manager republishes the full list on load).\nlet maxRemaining = -1;\nconst reached: number[] = [];\n\n// planting_state is published only on transitions (volatile), so these count\n// what this Foxglove session has seen - a late join misses earlier obstacles.\nlet obstacleState: ObstacleState = \"CLEAR\";\nlet obstaclesSkipped = 0;\nlet lastObstacleT = -1;\n\nfunction planLength(msg: any): number {\n  if (PLAN_FIELD && Array.isArray(msg[PLAN_FIELD])) return msg[PLAN_FIELD].length;\n  for (const v of Object.values(msg ?? {})) if (Array.isArray(v)) return v.length;\n  return -1;\n}\n\nfunction onPlantingState(state: string, t: number): void {\n  if (state === \"DIGGING_OBSTACLE\") {\n    if (obstacleState !== \"ACTIVE\") obstaclesSkipped += 1;\n    obstacleState = \"ACTIVE\";\n    lastObstacleT = t;\n  } else if (state === \"IDLE\") {\n    // DIGGING_OBSTACLE -> IDLE is the abort finishing: auger home, site skipped.\n    if (obstacleState === \"ACTIVE\") obstacleState = \"SKIPPED\";\n  } else {\n    // Any other state (a new sequence starting, COMPLETE, FAULT) clears it.\n    obstacleState = \"CLEAR\";\n  }\n}\n\nexport default function script(event: Ev): Output | undefined {\n  const t = event.receiveTime.sec + event.receiveTime.nsec * 1e-9;\n  if (event.topic === \"/planning/complete_plan\") total = planLength(event.message);\n  else if (event.topic === \"/planning/remaining_plan\") {\n    remaining = planLength(event.message);\n    maxRemaining = Math.max(maxRemaining, remaining);\n  }\n  else if (event.topic === \"/behavior/on_seedling_reached\") reached.push(t);\n  else if (event.topic === \"/planting_state\") onPlantingState(String(event.message?.data ?? \"\").trim(), t);\n\n  while (reached.length && t - reached[0] > RATE_WINDOW_S) reached.shift();\n  if (remaining < 0) return undefined;\n  const n = total >= 0 ? total : maxRemaining;\n\n  // plan_manager pops a site on arrival whatever the outcome, so sites skipped\n  // for a digging obstacle are not in remaining_plan but were not planted.\n  const visited = Math.max(0, n - remaining);\n  const planted = Math.max(0, visited - obstaclesSkipped);\n  const span = reached.length > 1 ? reached[reached.length - 1] - reached[0] : 0;\n  const rate = span > 0 ? ((reached.length - 1) / span) * 3600 : 0;\n\n  let summary =\n    n > 0 && remaining === 0\n      ? obstaclesSkipped > 0\n        ? `Mission complete: ${planted} out of ${n} seedlings are planted.`\n        : `All ${n} seedlings are planted — mission complete.`\n      : `${planted} out of ${n} seedlings are planted.`;\n  if (obstacleState === \"ACTIVE\")\n    summary += \" ⚠ Digging obstacle — auger retracting, skipping this seedling.\";\n  if (obstaclesSkipped > 0)\n    summary += ` ${obstaclesSkipped} site${obstaclesSkipped === 1 ? \"\" : \"s\"} skipped (digging obstacle).`;\n\n  return {\n    planted,\n    total: n,\n    remaining,\n    // Sites done (planted or skipped), so a finished mission reads 100%.\n    percent_complete: n > 0 ? (100 * visited) / n : 0,\n    rate_per_hour: rate,\n    minutes_since_last: reached.length ? (t - reached[reached.length - 1]) / 60 : -1,\n    eta_minutes: rate > 0 ? (remaining / rate) * 60 : -1,\n    digging_obstacle: obstacleState === \"ACTIVE\",\n    obstacle_state: obstacleState,\n    obstacles_skipped: obstaclesSkipped,\n    minutes_since_obstacle: lastObstacleT >= 0 ? (t - lastObstacleT) / 60 : -1,\n    summary,\n  };\n}\n"
        },
        "terrain-slope": {
            "name": "terrain_slope",
            "sourceCode": "// Terrain slope from IMU gravity vector (works without an orientation estimate).\n// Low-pass filtered; valid while the robot isn't accelerating hard.\nconst IMU_TOPIC = \"/w200_0120/sensors/imu_0/data\";\nconst ALPHA = 0.1;             // smoothing (0..1, lower = smoother)\n\nexport const inputs = [IMU_TOPIC];\nexport const output = \"/studio_script/terrain_slope\";\n\ntype Output = { pitch_deg: number; roll_deg: number; slope_deg: number };\ntype Ev = { topic: string; receiveTime: { sec: number; nsec: number }; message: any };\n\nlet ax = 0, ay = 0, az = 9.81, init = false;\nconst deg = (r: number) => (r * 180) / Math.PI;\n\nexport default function script(event: Ev): Output {\n  const a = event.message.linear_acceleration;\n  if (!init) { ax = a.x; ay = a.y; az = a.z; init = true; }\n  ax += ALPHA * (a.x - ax); ay += ALPHA * (a.y - ay); az += ALPHA * (a.z - az);\n  const pitch = Math.atan2(-ax, Math.sqrt(ay * ay + az * az));\n  const roll = Math.atan2(ay, az);\n  const slope = Math.acos(Math.min(1, Math.abs(az) / Math.sqrt(ax*ax + ay*ay + az*az)));\n  return { pitch_deg: deg(pitch), roll_deg: deg(roll), slope_deg: deg(slope) };\n}\n"
        }
    },
    "playbackConfig": {
        "speed": 1
    },
    "layout": "Tab!root"
}