<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile for w200_bridge only (domain_bridge, see config/w200_bridge.yaml).

  The bridge has two participants: one in domain 0 that talks to the W200 over
  the robot link (192.168.131.x), and one in domain 1 that talks to the local
  Jetson stack over shared memory / loopback. Both read this profile.

  The Jetson has several networks (wifi, 192.168.0.x / 192.168.1.x for sensors
  and the arm, 192.168.131.x to the W200). With default settings Fast DDS uses
  all of them and the W200 never receives our discovery traffic: we can see its
  topics but no messages arrive. So UDP is limited to the robot link and
  loopback, and the W200 PC is found by unicast instead of multicast.

  The 4 MB UDP buffers below need higher kernel limits (once, with sudo):
    printf 'net.core.rmem_max=8388608\nnet.core.wmem_max=8388608\n' | sudo tee /etc/sysctl.d/60-ros-dds.conf
    sudo sysctl -p /etc/sysctl.d/60-ros-dds.conf
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <!-- Zero-copy transport for nodes on this Jetson (point clouds, images). -->
    <transport_descriptor>
      <transport_id>canopy_shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>canopy_udp</transport_id>
      <type>UDPv4</type>
      <!-- 4 MB socket buffers (Linux default is 208 KB). Under CPU load the
           small default fills up and DDS drops packets. Requires
           net.core.rmem_max / wmem_max >= 4 MB (see header), otherwise
           the kernel silently caps it at the default. -->
      <sendBufferSize>4194304</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>192.168.131.100</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="canopy_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>canopy_shm</transport_id>
        <transport_id>canopy_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <!-- Only the W200 PC is listed (default ports; its participants also
             announce to us). Local nodes are deliberately NOT listed: this
             Fast DDS version does not check the domain ID of announcements
             sent to explicit ports, so listing them would let the bridge's
             domain-0 participant match the domain-1 stack directly and loop
             messages. The bridge's domain-1 participant is still found
             because every local node announces to all domain-1 ports
             (see fastdds_canopy.xml). -->
        <initialPeersList>
          <locator><udpv4><address>192.168.131.1</address></udpv4></locator>
        </initialPeersList>
        <discovery_config>
          <initialAnnouncements>
            <count>5</count>
            <period>
              <nanosec>100000000</nanosec>
            </period>
          </initialAnnouncements>
        </discovery_config>
      </builtin>
    </rtps>
  </participant>

  <!-- Applies to every writer, including service and action request/reply
       writers. A lost reliable message is resent after ~0.1 s instead of the
       Fast DDS default of 3 s (the cause of the 3 s arm stalls). Heartbeats are
       only sent while a writer has unacknowledged messages. If CPU load rises
       noticeably, try 500 ms. -->
  <data_writer profile_name="canopy_default_writer" is_default_profile="true">
    <times>
      <heartbeatPeriod>
        <sec>0</sec>
        <nanosec>100000000</nanosec>
      </heartbeatPeriod>
    </times>
  </data_writer>
</profiles>
