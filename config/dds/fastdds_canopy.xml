<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile for the Canopy Jetson stack (every node except w200_bridge).

  Local only: shared memory + UDP on loopback, ROS_DOMAIN_ID 1. The stack does
  not talk to the W200 directly. Every Jetson process used to be a DDS
  participant the W200 had to keep up with, and that traffic grew faster than
  the number of processes (10-28 bench: 30 idle nodes = 60,000 packets/s on the
  W200 link and 68% CPU; 8% without the W200). The only process that talks to
  the W200 is w200_bridge (domain_bridge, started by gnss_bringup.launch.py with
  fastdds_w200_bridge.xml), which forwards just the topics in
  config/w200_bridge.yaml.

  Enable (every terminal, e.g. in ~/.bashrc):
    export ROS_DOMAIN_ID=1
    export FASTRTPS_DEFAULT_PROFILES_FILE=~/dev/ros2_ws/src/canopy/config/dds/fastdds_canopy.xml
  then `ros2 daemon stop` once so the daemon reloads it. The discovery ports
  below only work for ROS_DOMAIN_ID 1.

  The 4 MB UDP buffers below need higher kernel limits (once, with sudo):
    printf 'net.core.rmem_max=8388608\nnet.core.wmem_max=8388608\n' | sudo tee /etc/sysctl.d/60-ros-dds.conf
    sudo sysctl -p /etc/sysctl.d/60-ros-dds.conf
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <!-- Zero-copy transport for nodes on this Jetson (point clouds, images). -->
    <transport_descriptor>
      <transport_id>canopy_shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>canopy_udp</transport_id>
      <type>UDPv4</type>
      <!-- 4 MB socket buffers (Linux default is 208 KB). Under CPU load the
           small default fills up and DDS drops packets. Requires
           net.core.rmem_max / wmem_max >= 4 MB (see header), otherwise
           the kernel silently caps it at the default. -->
      <sendBufferSize>4194304</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="canopy_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>canopy_shm</transport_id>
        <transport_id>canopy_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <!-- Unicast discovery, so we don't depend on multicast.
             Local nodes only (no W200 address or peer).
             Each process on this host is a separate participant on port
             7400 + 250 * domain + 10 + 2 * id. Without a port, Fast DDS only
             probes ids 0-4, so once long-running nodes hold those ids, newly
             started processes can't find each other. Ports below are for
             ROS_DOMAIN_ID 1, ids 0-40. -->
        <initialPeersList>
          <locator><udpv4><address>127.0.0.1</address><port>7660</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7662</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7664</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7666</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7668</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7670</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7672</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7674</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7676</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7678</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7680</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7682</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7684</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7686</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7688</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7690</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7692</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7694</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7696</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7698</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7700</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7702</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7704</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7706</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7708</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7710</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7712</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7714</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7716</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7718</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7720</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7722</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7724</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7726</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7728</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7730</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7732</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7734</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7736</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7738</port></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address><port>7740</port></udpv4></locator>
        </initialPeersList>
        <discovery_config>
          <initialAnnouncements>
            <count>5</count>
            <period>
              <nanosec>100000000</nanosec>
            </period>
          </initialAnnouncements>
        </discovery_config>
      </builtin>
    </rtps>
  </participant>

  <!-- Applies to every writer, including service and action request/reply
       writers. A lost reliable message is resent after ~0.1 s instead of the
       Fast DDS default of 3 s (the cause of the 3 s arm stalls). Heartbeats are
       only sent while a writer has unacknowledged messages. If CPU load rises
       noticeably, try 500 ms. -->
  <data_writer profile_name="canopy_default_writer" is_default_profile="true">
    <times>
      <heartbeatPeriod>
        <sec>0</sec>
        <nanosec>100000000</nanosec>
      </heartbeatPeriod>
    </times>
  </data_writer>
</profiles>
